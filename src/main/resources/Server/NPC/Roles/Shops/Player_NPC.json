{
  "Type": "Generic",
  "StartState": "Idle",
  "BusyStates": [
    "$Interaction"
  ],
  "Appearance": "Player",
  "MaxHealth": 50,
  "NameTranslationKey": {
    "Compute": "NameTranslationKey"
  },
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 5,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10
    }
  ],
  "Instructions": [
    {
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": "Idle"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Player",
                "Range": 8
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "Watching"
                }
              ],
              "$Comment": "Switch to watching when player approaches"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "BodyMotion": {
                "Type": "Nothing"
              }
            }
          ],
          "$Comment": "Idle state - no player nearby"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": "Watching"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Player",
                "Range": 12
              },
              "HeadMotion": {
                "Type": "Watch"
              },
              "Continue": true,
              "$Comment": "Watch nearby players with head"
            },
            {
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "Player",
                  "Range": 12
                }
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "Idle"
                }
              ],
              "$Comment": "Return to Idle when player leaves"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "BodyMotion": {
                "Type": "Nothing"
              }
            }
          ],
          "$Comment": "Watching state - player is nearby, just watch them"
        },
        {
          "Sensor": {
            "Type": "State",
            "State": "$Interaction"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Target",
                "Range": 10
              },
              "HeadMotion": {
                "Type": "Watch"
              },
              "Continue": true
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "Timeout",
                  "Delay": [
                    1,
                    1
                  ],
                  "Action": {
                    "Type": "Sequence",
                    "Actions": [
                      {
                        "Type": "ReleaseTarget"
                      },
                      {
                        "Type": "State",
                        "State": "Watching"
                      }
                    ]
                  }
                }
              ],
              "$Comment": "Return to Watching after interaction ends"
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "BodyMotion": {
                "Type": "Nothing"
              }
            }
          ],
          "$Comment": "Interaction state - look at player while shop is open"
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "Sensor": {
          "Type": "Not",
          "Sensor": {
            "Type": "CanInteract",
            "ViewSector": 180
          }
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": false
          }
        ]
      },
      {
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "server.interactionHints.trade"
          }
        ],
        "Continue": true
      },
      {
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Instructions": [
          {
            "Sensor": {
              "Type": "Not",
              "Sensor": {
                "Type": "State",
                "State": "$Interaction"
              }
            },
            "Actions": [
              {
                "Type": "LockOnInteractionTarget"
              },
              {
                "Type": "OpenNpcDialogue"
              },
              {
                "Type": "OpenVaultShop"
              },
              {
                "Type": "State",
                "State": "$Interaction"
              }
            ]
          }
        ]
      }
    ]
  },
  "Parameters": {
    "Invulnerable": {
      "Value": true,
      "Description": "Whether this NPC is invulnerable."
    },
    "MemoriesNameOverride": {
      "Value": "Player",
      "Description": "Overrides the memory name if set"
    },
    "NameTranslationKey": {
      "Value": "Player",
      "Description": "Translation key for NPC name display"
    }
  },
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Neutral",
  "IsMemory": false,
  "MemoriesCategory": "Kweebec",
  "MemoriesNameOverride": {
    "Compute": "MemoriesNameOverride"
  },
  "DisableDamageGroups": [
    "Self"
  ],
  "CombatConfig": {
    "EntityEffects": [
      "Immunity_Environmental"
    ]
  },
  "Invulnerable": {
    "Compute": "Invulnerable"
  },
  "KnockbackScale": 0.5
}
