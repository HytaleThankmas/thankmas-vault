$C = "../Common.ui";

$C.@PageOverlay {
  Anchor: (Width: 980, Left: 0);
}

$C.@DecoratedContainer {
  Anchor: (Width: 800, Left: 40);
  Padding: (Top: 25, Bottom: 90);

  #Title {
    Label #ShopTitle {
      Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
      Padding: (Horizontal: 19);
      Text: "Shop";
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 15, Vertical: 3);

    Group #HeaderInfo {
      LayoutMode: Left;
      Anchor: (Height: 20);
      Padding: (Left: 8, Right: 8, Bottom: 4);

      Label #BalanceTitle {
        Style: (FontSize: 15, TextColor: #8a9aaa);
        Text: "Your Balance: ";
      }

      Label #PlayerBalance {
        Style: (FontSize: 16, TextColor: #f0c040, RenderBold: true);
        Text: "0 Coins";
      }
    }

    Group #Divider {
      Anchor: (Height: 2);
      Background: #19252F;
      Padding: (Bottom: 6);
    }

    // item grid
    Group #ShopBody {
      LayoutMode: Left;
      Group #ItemsGridContainer {
        Anchor: (Width: 330);
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Top: 8, Left: 3, Right: 3, Bottom: 30);
        LayoutMode: TopScrolling;

        Group #ItemsGrid {
          LayoutMode: Top;
        }
      }

      //SHop right (item info)
      Group #ItemInfoContainer {
        LayoutMode: Top;
        Padding: (Top: 8, Left: 16, Right: 8, Bottom: 30);
        Group #ItemInfoHeader {
          LayoutMode: Left;
          Padding: (Bottom: 10);
          ItemSlot #ItemIcon {
            Anchor: (Width: 64, Height: 64);
            ShowQualityBackground: false;
          }
          Group #ItemHeaderMeta {
            LayoutMode: Top;
            Padding: (Left: 12);
            Label #ItemName {
              Style: (FontSize: 18, TextColor: #ffffff, RenderBold: true);
              Text: "Item Name";
            }
            Group #ItemCostRow {
              LayoutMode: Left;
              Padding: (Top: 6);
              Label #ItemCostLabel {
                Style: (FontSize: 14, TextColor: #8a9aaa);
                Text: "Cost: ";
              }
              Label #ItemCost {
                Style: (FontSize: 15, TextColor: #f0c040, RenderBold: true);
                Text: "-- Coins";
              }
            }
          }
        }
        Group #ItemInfoDivider {
          Anchor: (Height: 1);
          Background: #19252F;
          Padding: (Bottom: 8);
        }
        Group #ItemDescriptionContainer {
          LayoutMode: Top;
          Label #ItemDescription {
            Anchor: (Width: 400);
            Style: (FontSize: 14, TextColor: #b0bec5, Wrap: true);
            Text: "Lorem ipsum dolor sit amet. Est aspernatur perspiciatis sed veritatis consequuntur et numquam tempore 33 soluta amet sit aspernatur tenetur. Et quasi ratione hic rerum quasi a reprehenderit illum non pariatur officia ad enim molestias. Et deleniti amet et tempora dolorum aut reprehenderit quidem rem officia enim qui quia quia. Cum perspiciatis consequatur quo autem nesciunt et fuga quod est neque laborum.Sit rerum natus ea temporibus Quis ut velit officiis et fugit sunt. Qui voluptatem ratione et harum similique et omnis facere qui dolores eligendi ut animi soluta. Sit esse culpa id doloremque debitis qui enim asperiores et excepturi placeat. Quo quaerat sunt qui consequuntur necessitatibus qui molestias facere est blanditiis omnis At asperiores itaque.Et maiores quaerat aut atque voluptate id placeat illo aut omnis tempora qui reprehenderit illum. Non aperiam iste ut consequatur alias vel rerum illo vel alias maxime id itaque praesentium qui nihil quae hic commodi dolores. Vel minus repellendus qui numquam repellat eos suscipit voluptatem in vero sapiente sed quos ducimus et quia impedit..";
          }
        }
      }
    }
  }
}

Group #Subtitle{

}
$C.@BackButton {

}