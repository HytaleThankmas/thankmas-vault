$C = "../Common.ui";
Group {
  Anchor: (Width: 120, Height: 160);
  Padding: (Horizontal: 12, Vertical: 12);
  Group #CardBorder {
    Anchor: (Full: 0);
    Background: #14202c;
    Padding: (Horizontal: 6, Vertical: 6);
    LayoutMode: Top;

    // Cost
    Group #CostArea {
      Anchor: (Height: 20);
      LayoutMode: Left;
      Label #ItemCost {
        Style: (
          FontSize: 14,
          TextColor: #a0c8e0,
          RenderBold: true,
        );
        Text: "10 Coins";
      }
    }

    // Item Icon container
    Group #IconContainer {
      Anchor: (Height: 100);
      LayoutMode: CenterMiddle;
      Group #SlotBorder {
        ItemSlot #ItemIcon {
          Anchor: (Width: 64, Height: 64);
          ShowQualityBackground: false;
        }
        Label #ItemQuantity {
          Anchor: (Right: 4, Bottom: 2);
          Style: (
            FontSize: 13,
            TextColor: #ffffff,
            HorizontalAlignment: End,
            VerticalAlignment: End,
            RenderBold: true,
          );
        }
      }
    }

    Group #Spacer {
      FlexWeight: 1;
    }

    // Item name
    Label #ItemName {
      Anchor: (Height: 12);
      Padding: (Top: 2);
      Style: (
        FontSize: 15,
        TextColor: #e0e8f0,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        RenderBold: true,
      );
      Text: "Item";
      }
  }
  // Buy Button
  Button #BuyButton {
    Anchor: (Width: 120, Height: 160);
  }
}