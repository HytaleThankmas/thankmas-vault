$C = "../Common.ui";

$C.@PageOverlay {
  Anchor: (Width: 980, Left: 0);
}

$C.@DecoratedContainer {
  Anchor: (Width: 900, Height: 700, Left: 20);
  Padding: (Top: 20, Bottom: 30);

  #Title {
    Label #PageTitle {
      Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
      Padding: (Horizontal: 19);
      Text: "NPC Directory & Teleport";
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 15, Vertical: 8);

    Group #SummaryRow {
      Anchor: (Height: 36);
      LayoutMode: Left;
      Padding: (Horizontal: 6, Vertical: 2);

      Label #SummaryText {
        Anchor: (Width: 170);
        Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
        Text: "NPCs: 0";
      }

      Label #SortByLabel {
        Anchor: (Width: 65);
        Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center);
        Text: "Sort by:";
      }

      $C.@SmallSecondaryTextButton #SortTypeButton {
        Anchor: (Width: 120, Height: 28);
        Padding: (Horizontal: 8);
        Text: "Type";
      }

      $C.@SmallSecondaryTextButton #SortIdButton {
        Anchor: (Width: 110, Height: 28, Left: 8);
        Padding: (Horizontal: 8);
        Text: "ID";
      }

      $C.@SmallSecondaryTextButton #SortDeliveryButton {
        Anchor: (Width: 130, Height: 28, Left: 8);
        Padding: (Horizontal: 8);
        Text: "Delivery";
      }

      $C.@SmallSecondaryTextButton #SortShopButton {
        Anchor: (Width: 110, Height: 28, Left: 8);
        Padding: (Horizontal: 8);
        Text: "Shop";
      }
    }

    Group #HeaderRow {
      Anchor: (Height: 28, Top: 6);
      Background: #0e151e;
      LayoutMode: Left;
      Padding: (Horizontal: 10, Vertical: 2);

      Label {
        Anchor: (Width: 230);
        Style: (FontSize: 13, TextColor: #7a9cc6, RenderBold: true, VerticalAlignment: Center);
        Text: "NPC Name / ID";
      }

      Label {
        Anchor: (Width: 140);
        Style: (FontSize: 13, TextColor: #7a9cc6, RenderBold: true, VerticalAlignment: Center);
        Text: "Type";
      }

      Label {
        Anchor: (Width: 120);
        Style: (FontSize: 13, TextColor: #7a9cc6, RenderBold: true, VerticalAlignment: Center);
        Text: "Delivery";
      }

      Label {
        Anchor: (Width: 120);
        Style: (FontSize: 13, TextColor: #7a9cc6, RenderBold: true, VerticalAlignment: Center);
        Text: "Shop";
      }

      Label {
        Anchor: (Width: 150);
        Style: (FontSize: 13, TextColor: #7a9cc6, RenderBold: true, VerticalAlignment: Center);
        Text: "Coordinates";
      }

      Label {
        Anchor: (Width: 70);
        Style: (FontSize: 13, TextColor: #7a9cc6, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: Center);
        Text: "Teleport";
      }
    }

    Group #NpcListContainer {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Top: 6, Left: 4, Right: 4);

      Group #NpcList {
        LayoutMode: Top;
      }
    }
  }
}

$C.@BackButton {}
