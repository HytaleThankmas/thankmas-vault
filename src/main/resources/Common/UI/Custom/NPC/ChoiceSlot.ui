$C = "../Common.ui";

@ChoiseButton = ButtonStyle(
  Default: (Background: PatchStyle(TexturePath: "Images/Button.png")),
  Hovered: (Background: PatchStyle(TexturePath: "Images/Button_Hovered.png")),
  Pressed: (Background: PatchStyle(TexturePath: "Images/Button_Pressed.png")),
  Disabled: (Background: PatchStyle(TexturePath: "Images/Button.png")),
  Sounds: $C.@ButtonSounds,
);

Group {
  Anchor: (Width: 880, Height: 50, Bottom:0);
  Padding: (Horizontal: 1, Vertical: 8);

  Button #ChoiceButton {
    Anchor: (Width: 333, Height: 50,Left:0);
    Style: @ChoiseButton;
  }

  Group #CardBorder {
    LayoutMode: Left;
    Padding: (Left: 44);
    AssetImage #ZoneIconImage {
      Anchor: (Width: 30, Height: 30,Left:5);
      AssetPath: "UI/Custom/NPC/Images/Speach.png";
    }

    Label #ChoiceText {
      Padding: (Left: 10);
      Style: (
        FontSize: 22,
        TextColor: #eceef6,
        VerticalAlignment: Center,
        RenderBold: true
      );
      Text: "Dialogue Choice";
    }
  }
}

