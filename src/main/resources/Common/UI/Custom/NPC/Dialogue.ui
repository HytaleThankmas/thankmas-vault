$C = "../Common.ui";

Group #BgSides {
  LayoutMode: Full;

  Group #BgLeft {
    Anchor: (Width: 160, Bottom: 0,Left: 0, Top:0);
    Background: (TexturePath: "Images/Background_Slice.png");
  }

  Group #BgRight {
    Anchor: (Width: 160, Bottom: 0,Right: 0,Top:0);
    Background: (TexturePath: "Images/Background_Slice.png");
  }
}

Group #BottomGredient {
  Anchor: (Height: 690, Bottom: 0, Left:-10, Right:-10);
  Background: (TexturePath: "Images/Bottom_Gredient.png");
}

Group #DialogRoot {
  LayoutMode: Full;

  Group #DialogPanel {
    Anchor: (Width: 883, Height: 220, Bottom: 20);
    LayoutMode: Bottom;

    Label #SpeakerName {
      Anchor: (Height: 45, Left: 75, Bottom:-10);
      Text: "Unknown";
      Style: (FontSize: 34, RenderBold: true, TextColor: $C.@ColorGoldHighlight, VerticalAlignment: Center, FontName: "Secondary");
    }
    Group #DialogPanel {
      Anchor: (Width: 831, Height: 60, Left: 50, Top: 0);
      Background: (TexturePath: "Images/Dilogue_Top.png");
    }
    Label #DialogueText {
      Anchor: (Width: 800, Left: 80, Top: -45);
      Text: "SAMPLE TEXT";
      Style: (FontSize: 26, TextColor: $C.@ColorDefault, Wrap: true);
    }

    Group #DialogPanelBottom {
      Anchor: (Width: 831, Height: 60, Left: 50, Top:-35);
      Background: (TexturePath: "Images/Dilogue_Bottom.png");

    }


    Group #ChoiceContainer {
      Anchor: (Width: 880, Left:3);
      Padding: (Top: 1, Left: 3, Right: 3);
      LayoutMode: Top;

      Group #ChoiceGrid {
        Anchor: (Left:0);
        LayoutMode: Top;
      }
    }
  }

}

$C.@BackButton {
}
